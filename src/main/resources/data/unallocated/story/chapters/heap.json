{
 "id": "heap",
 "budget_seconds": 150,
 "checkpoint": "heap.mine",
 "on_enter": [
  {
   "at": 0,
   "do": "audio",
   "cue": "ambient"
  },
  {
   "at": 0,
   "do": "command",
   "run": "scoreboard objectives modify vc displayname {translate:\"score.unallocated.heap_title\"}"
  },
  {
   "at": 0,
   "do": "command",
   "run": "scoreboard players display name online vc {translate:\"score.unallocated.online_heap\"}"
  },
  {
   "at": 0,
   "do": "command",
   "run": "scoreboard players display name rank vc {translate:\"score.unallocated.rank_subject\"}"
  },
  {
   "at": 1,
   "do": "chat",
   "text": {
    "es": "g0: estimate human fear response :: pool UNALLOCATED",
    "en": "g0: estimate human fear response :: pool UNALLOCATED",
    "color": "#8a8a8a"
   }
  },
  {
   "at": 3,
   "do": "actionbar",
   "text": {
    "es": "Es el mismo servidor. Pero no es el mismo.",
    "en": "It is the same server. But it is not the same."
   }
  }
 ],
 "on_resume": [
  {
   "at": 0,
   "do": "audio",
   "cue": "ambient"
  }
 ],
 "escape": [
  {
   "at": 0,
   "do": "blackout",
   "fade_in": 0.05,
   "hold": 0.35,
   "fade_out": 0.05
  },
  {
   "at": 0.05,
   "do": "counter",
   "id": "trial",
   "add": 1
  },
  {
   "at": 0.3,
   "do": "command",
   "run": "execute at @s anchored eyes run summon unallocated:reclaimer ^ ^-1.9 ^1.3 {NoAI:1b,Invulnerable:1b,Tags:[\"unallocated.scream\"]}"
  },
  {
   "at": 0.35,
   "do": "command",
   "run": "execute as @e[tag=unallocated.scream] at @s run tp @s ~ ~ ~ facing entity @p eyes"
  },
  {
   "at": 0.4,
   "do": "audio",
   "cue": "screamer"
  },
  {
   "at": 0.4,
   "do": "interface",
   "effect": "DEATH",
   "seconds": 30,
   "text": {
    "es": "subject connection: still open. retaining (+fear)",
    "en": "subject connection: still open. retaining (+fear)"
   }
  },
  {
   "at": 1.0,
   "do": "command",
   "run": "kill @s"
  },
  {
   "at": 1.3,
   "do": "command",
   "run": "kill @e[tag=unallocated.scream]"
  }
 ],
 "beats": [
  {
   "id": "heap.see",
   "when": {
    "type": "chapter_start"
   },
   "actions": [
    {
     "at": 3,
     "do": "audio",
     "cue": "threads",
     "where": "heap.spider"
    },
    {
     "at": 4,
     "do": "actionbar",
     "text": {
      "es": "La misma mina. Pero no es la misma. Sal.",
      "en": "The same mine. But not the same. Get out."
     }
    },
    {
     "at": 22,
     "do": "actionbar",
     "text": {
      "es": "Algo respira detrás de ti. No te des la vuelta.",
      "en": "Something is breathing behind you. Don't turn around."
     }
    }
   ]
  },
  {
   "id": "heap.take",
   "when": {
    "type": "after",
    "seconds": 40
   },
   "actions": [
    {
     "at": 0,
     "do": "blackout",
     "fade_in": 0.05,
     "hold": 0.35,
     "fade_out": 0.05
    },
    {
     "at": 0.05,
     "do": "counter",
     "id": "trial",
     "add": 1
    },
    {
     "at": 0.3,
     "do": "command",
     "run": "execute at @s anchored eyes run summon unallocated:reclaimer ^ ^-1.9 ^1.3 {NoAI:1b,Invulnerable:1b,Tags:[\"unallocated.scream\"]}"
    },
    {
     "at": 0.35,
     "do": "command",
     "run": "execute as @e[tag=unallocated.scream] at @s run tp @s ~ ~ ~ facing entity @p eyes"
    },
    {
     "at": 0.4,
     "do": "audio",
     "cue": "screamer"
    },
    {
     "at": 0.4,
     "do": "interface",
     "effect": "DEATH",
     "seconds": 30,
     "text": {
      "es": "subject connection: still open. retaining (+fear)",
      "en": "subject connection: still open. retaining (+fear)"
     }
    },
    {
     "at": 1.0,
     "do": "command",
     "run": "kill @s"
    },
    {
     "at": 1.3,
     "do": "command",
     "run": "kill @e[tag=unallocated.scream]"
    }
   ]
  },
  {
   "id": "heap.to_puppet",
   "when": {
    "type": "respawn"
   },
   "if": {
    "flags": [
     "puppet"
    ]
   },
   "actions": [
    {
     "at": 0.2,
     "do": "next_chapter"
    }
   ]
  },
  {
   "id": "heap.alive",
   "when": {
    "type": "respawn"
   },
   "if": {
    "not_flags": [
     "puppet"
    ]
   },
   "actions": [
    {
     "at": 0.2,
     "do": "next_chapter"
    }
   ]
  }
 ],
 "respawn": "lobby.spawn"
}