     "text": {
      "es": "yo no lo podía leer. solo podía intentarlo otra vez.",
      "en": "i could not read it. i could only try again.",
      "color": "#e8e8e8"
     },
     "from": {
      "es": "Reclaimer",
      "en": "Reclaimer"
