  {
   "id": "kernel.timeout",
   "when": {
    "type": "after",
    "seconds": 92,
    "beat": "kernel.suspend"
   },
   "if": {
    "not_flags": [
     "completed",
     "poisoned"
    ]
   },
   "actions": [
    {
     "at": 0,
     "do": "chat",
     "text": {
      "es": "watchdog :: restart",
      "color": "#aa0000"
     }
    },
    {
     "at": 0,
     "do": "audio",
     "cue": "screamer"
    },
    {
     "at": 0,
     "do": "creature",
     "op": "chase",
     "id": "spider",
     "speed": 6,
     "catch_distance": 1.5
    },
    {
     "at": 0.5,
     "do": "command",
     "run": "bossbar remove unallocated:watchdog"
    },
    {
     "at": 3,
     "do": "end",
     "ending": "CONSUMED"
    }
   ]
  },
  {
   "id": "kernel.wakes",
   "when": {
    "type": "after",
    "seconds": 75,
    "beat": "kernel.cross"
