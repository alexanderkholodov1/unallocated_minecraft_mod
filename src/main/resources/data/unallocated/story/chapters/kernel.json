    "type": "chat",
    "pattern": "^\\s*set\\s+success_threshold\\s+0?[.,]82\\s*$",
    "hide": true
   },
   "if": {
    "flags": [
     "suspended"
    ],
    "not_flags": [
     "poisoned",
     "completed"
    ]
   },
   "actions": [
    {
     "at": 0,
     "do": "flag",
