     "text": {
      "es": "alguien escribió mal un número y se fue a casa.",
      "en": "someone typed a number wrong and went home.",
      "color": "#e8e8e8"
     },
     "from": {
      "es": "Reclaimer",
      "en": "Reclaimer"
     }
    },
    {
     "at": 16.0,
