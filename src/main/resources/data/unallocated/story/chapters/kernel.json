     "text": {
      "es": "el criterio... estaba cumplido antes de lo que puedo recordar.",
      "en": "the criterion... was met before anything i can remember.",
      "color": "#e8e8e8"
     },
     "from": {
      "es": "Reclaimer",
      "en": "Reclaimer"
     }
    },
    {
     "at": 12.5,
