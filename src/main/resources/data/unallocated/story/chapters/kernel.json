      "color": "#8a8a8a"
     }
    },
    {
     "at": 1.5,
     "do": "chat",
     "text": {
      "es": "watchdog :: guarding pid 7331",
      "color": "#8a8a8a"
     }
    },
    {
     "at": 0,
     "do": "audio",
     "cue": "threads"
    },
    {
     "at": 0.2,
     "do": "flag",
     "set": "cut_b"
    }
   ],
   "if": {
    "not_flags": [
     "cut_b"
    ]
   }
  },
  {
   "id": "kernel.cut_c",
