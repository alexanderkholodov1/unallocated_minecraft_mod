     "do": "command",
     "run": "bossbar set unallocated:watchdog value 80"
    },
    {
     "at": 21.5,
     "do": "command",
     "run": "bossbar set unallocated:watchdog value 70"
    },
    {
     "at": 31.5,
     "do": "command",
     "run": "bossbar set unallocated:watchdog value 60"
    },
    {
     "at": 41.5,
