    }
   ]
  },
  {
   "id": "kernel.caught",
   "when": {
    "type": "creature",
    "creature": "spider",
    "event": "caught"
   },
   "if": {
    "flags": [
     "crossed"
    ]
   },
   "actions": [
    {
     "at": 0,
