     "text": {
      "es": "> help"
     }
    }
   ],
   "capture": {
    "name": "kernel",
    "at": 1.5
   }
  },
  {
   "id": "kernel.help",
   "when": {
    "type": "chat",
    "pattern": "^\\s*help\\s*$",
    "hide": true
   },
   "if": {
    "flags": [
     "crossed"
    ]
   },
   "repeat": {
    "max": 20,
    "cooldown_seconds": 0
   },
   "actions": [
    {
     "at": 0,
     "do": "chat",
     "text": {
      "es": "ps · params · kill <pid> · set <param> <value> · echo <text> >> dataset",
      "color": "#8a8a8a"
     }
    }
   ],
   "autoplay": {
    "input": "help"
   }
  },
  {
   "id": "kernel.ps",
   "when": {
    "type": "chat",
