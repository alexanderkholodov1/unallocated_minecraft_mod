   "actions": [
    {
     "at": 0,
     "do": "chat",
     "text": {
      "es": "subject 4114 :: reclasificado: intrusión. trials: 0. próxima captura = definitiva.",
      "color": "#aa0000"
     }
    },
    {
     "at": 0,
     "do": "audio",
     "cue": "threads"
