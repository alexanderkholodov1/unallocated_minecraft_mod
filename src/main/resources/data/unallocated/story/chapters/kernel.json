{
 "id": "kernel",
 "budget_seconds": 240,
 "checkpoint": "kernel.gate",
 "on_enter": [
  {
   "at": 0,
   "do": "title",
   "title": {
    "es": "Trial {counter:trial}"
   },
   "fade_in": 0.3,
   "stay": 2.5,
   "fade_out": 1
  },
  {
   "at": 0,
   "do": "command",
   "run": "effect give @s minecraft:night_vision infinite 0 true"
  },
  {
   "at": 0.5,
   "do": "command",
   "run": "give @s minecraft:shears[minecraft:can_break={blocks:\"minecraft:tripwire\"}]"
  },
  {
   "at": 1,
   "do": "creature",
   "op": "spawn",
   "id": "spider",
   "body": {
    "summon": "minecraft:spider{attributes:[{id:\"minecraft:scale\",base:2.2d}]}"
   },
   "where": "kernel.heart",
   "facing": "player"
  },
  {
   "at": 1.1,
   "do": "creature",
   "op": "face_player",
   "id": "spider"
  },
  {
   "at": 2,
   "do": "audio",
   "cue": "threads",
   "where": "kernel.heart"
  }
 ],
 "on_resume": [
  {
   "at": 0,
   "do": "command",
   "run": "effect give @s minecraft:night_vision infinite 0 true"
  }
 ],
 "escape": [
  {
   "at": 0,
   "do": "end",
   "ending": "CONSUMED"
  }
 ],
 "beats": [
  {
   "id": "kernel.cut_a",
   "when": {
    "type": "break",
    "block": "minecraft:tripwire",
    "zone": "heap.cut_a"
   },
   "actions": [
    {
     "at": 0,
     "do": "chat",
     "text": {
      "es": "human_playtest_pool: UNALLOCATED",
      "color": "#8a8a8a"
     }
    },
    {
     "at": 1.5,
     "do": "chat",
     "text": {
      "es": "reclaim pool ... UNALLOCATED",
      "color": "#8a8a8a"
     }
    },
    {
     "at": 0,
     "do": "audio",
     "cue": "threads"
    },
    {
     "at": 0.2,
     "do": "flag",
     "set": "cut_a"
    }
   ],
   "if": {
    "not_flags": [
     "cut_a"
    ]
   }
  },
  {
   "id": "kernel.cut_b",
   "when": {
    "type": "break",
    "block": "minecraft:tripwire",
    "zone": "heap.cut_b"
