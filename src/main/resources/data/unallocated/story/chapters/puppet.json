{
 "id": "puppet",
 "budget_seconds": 1200,
 "checkpoint": "heap.arrival",
 "respawn": "lobby.spawn",
 "stay": true,
 "on_enter": [
  {
   "at": 0,
   "do": "audio",
   "cue": "ambient"
  }
 ],
 "on_resume": [],
 "escape": [
  {
   "at": 0,
   "do": "chat",
   "text": {
    "es": "subject 4114 :: reclasificado: intrusión",
    "en": "subject 4114 :: reclassified: intrusion",
    "color": "#aa0000"
   }
  }
 ],
 "beats": [
  {
   "id": "puppet.start",
   "when": {
    "type": "chapter_start"
   },
   "if": {
    "flags": [
     "puppet"
    ]
   },
   "actions": [
    {
     "at": 0.5,
     "do": "command",
     "run": "clear @s minecraft:shears"
    },
    {
     "at": 0.6,
     "do": "command",
     "run": "give @s minecraft:shears[minecraft:custom_name={translate:\"item.unallocated.shears\",italic:false}]"
    },
    {
     "at": 2,
     "do": "chat",
     "text": {
      "es": "subject connection: still open. retaining (+fear)",
      "en": "subject connection: still open. retaining (+fear)",
      "color": "#8a8a8a"
     }
    },
    {
     "at": 7,
     "do": "chat",
     "text": {
      "es": "artifact[subject 4114] :: training (gen {counter:trial})",
      "en": "artifact[subject 4114] :: training (gen {counter:trial})",
      "color": "#8a8a8a"
     }
    },
    {
     "at": 10,
     "do": "actionbar",
     "text": {
      "es": "Ves sus hilos. Suben al cielo, hacia algo que escucha.",
      "en": "You can see its threads. They rise into the sky, toward something that listens."
     }
    },
    {
     "at": 4.2,
     "do": "creature",
     "op": "spawn",
     "id": "soul1",
     "body": {
      "mannequin": {
       "profile": "player",
       "texture": "unallocated:textures/entity/soul/soul_1.png",
       "scale": 1
      }
     },
     "where": {
      "anchor": "heap.arrival",
      "offset": [
       9,
       0,
       -7
      ]
     },
     "facing": "player"
    },
    {
     "at": 4.4,
     "do": "creature",
     "op": "spawn",
     "id": "soul2",
     "body": {
      "mannequin": {
       "profile": "player",
       "texture": "unallocated:textures/entity/soul/soul_2.png",
       "scale": 1
      }
     },
     "where": {
      "anchor": "heap.arrival",
      "offset": [
       -7,
       0,
       9
      ]
     },
     "facing": "player"
    },
    {
     "at": 4.6,
     "do": "creature",
     "op": "spawn",
     "id": "soul3",
     "body": {
      "mannequin": {
       "profile": "player",
       "texture": "unallocated:textures/entity/soul/soul_3.png",
       "scale": 1
      }
     },
     "where": {
      "anchor": "heap.arrival",
      "offset": [
       14,
       0,
       8
      ]
     },
     "facing": "player"
    },
    {
     "at": 4.8,
     "do": "creature",
     "op": "spawn",
     "id": "soul4",
     "body": {
      "mannequin": {
       "profile": "player",
       "texture": "unallocated:textures/entity/soul/soul_4.png",
       "scale": 1
      }
     },
     "where": {
      "anchor": "heap.arrival",
      "offset": [
       -9,
       0,
       -6
      ]
     },
     "facing": "player"
    },
    {
     "at": 0.5,
     "do": "audio",
     "cue": "ambient"
    },
    {
     "at": 16,
     "do": "actionbar",
     "text": {
      "es": "Muerto, el chat es su consola. Escribe help.",
      "en": "Dead, the chat is its console. Type help."
     }
    }
   ]
  },
  {
   "id": "puppet.alive_start",
   "when": {
    "type": "chapter_start"
   },
   "if": {
    "not_flags": [
     "puppet"
    ]
   },
   "actions": [
    {
     "at": 0.3,
     "do": "title",
     "title": {
      "es": "Trial {counter:trial}",
      "en": "Trial {counter:trial}"
     },
     "fade_in": 0.3,
     "stay": 2,
     "fade_out": 1
    },
    {
     "at": 0.2,
     "do": "command",
     "run": "time set 18000"
    },
    {
     "at": 3,
     "do": "actionbar",
     "text": {
      "es": "Vuelves. El servidor parece normal otra vez.",
      "en": "You are back. The server looks normal again."
     }
    },
    {
     "at": 20,
     "do": "actionbar",
     "text": {
      "es": "La conexión sigue abierta. Lo sientes.",
      "en": "The connection is still open. You can feel it."
     }
    },
    {
     "at": 45,
     "do": "blackout",
     "fade_in": 0.05,
     "hold": 0.35,
     "fade_out": 0.05
    },
    {
     "at": 45.05,
     "do": "counter",
     "id": "trial",
     "add": 1
    },
    {
     "at": 45.3,
     "do": "command",
     "run": "execute at @s anchored eyes run summon unallocated:reclaimer ^ ^-1.9 ^1.3 {NoAI:1b,Invulnerable:1b,Tags:[\"unallocated.scream\"]}"
    },
    {
     "at": 45.35,
     "do": "command",
     "run": "execute as @e[tag=unallocated.scream] at @s run tp @s ~ ~ ~ facing entity @p eyes"
    },
    {
     "at": 45.4,
     "do": "audio",
     "cue": "screamer"
    },
    {
     "at": 45.4,
     "do": "interface",
     "effect": "DEATH",
     "seconds": 30,
     "text": {
      "es": "subject connection: still open. retaining (+fear)",
      "en": "subject connection: still open. retaining (+fear)"
     }
    },
    {
     "at": 46.0,
     "do": "command",
     "run": "kill @s"
    },
    {
     "at": 46.3,
     "do": "command",
     "run": "kill @e[tag=unallocated.scream]"
    },
    {
     "at": 0.5,
     "do": "audio",
     "cue": "ambient"
    },
    {
     "at": 1.9,
     "do": "command",
     "run": "clear @s minecraft:written_book"
    },
    {
     "at": 2,
     "do": "command",
     "run": "give @s minecraft:written_book[minecraft:written_book_content={title:\"Noor\",author:\"Noor\",pages:[{raw:{translate:\"story.unallocated.puppetbook.0\"}},{raw:{translate:\"story.unallocated.puppetbook.1\"}},{raw:{translate:\"story.unallocated.puppetbook.2\"}}]}]"
    },
    {
     "at": 6,
     "do": "actionbar",
     "text": {
      "es": "Hay un libro en tu inventario que no estaba antes.",
      "en": "There is a book in your inventory that was not there before."
     }
    }
   ]
  },
