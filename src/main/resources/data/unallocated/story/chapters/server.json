{
 "id": "server",
 "budget_seconds": 420,
 "checkpoint": "lobby.spawn",
 "on_enter": [
  {
   "at": 0,
   "do": "audio",
   "cue": "ambient"
  },
  {
   "at": 0,
   "do": "command",
   "run": "unallocated tab frame"
  },
  {
   "at": 0,
   "do": "command",
   "run": "scoreboard objectives add vc dummy {translate:\"score.unallocated.title\"}"
  },
  {
   "at": 0.1,
   "do": "command",
   "run": "scoreboard objectives setdisplay sidebar vc"
  },
  {
   "at": 0.1,
   "do": "command",
   "run": "scoreboard objectives modify vc numberformat blank"
  },
  {
   "at": 0.2,
   "do": "command",
   "run": "scoreboard players set mode vc 5"
  },
  {
   "at": 0.2,
   "do": "command",
   "run": "scoreboard players display name mode vc {translate:\"score.unallocated.mode\"}"
  },
  {
   "at": 0.2,
   "do": "command",
   "run": "scoreboard players set online vc 4"
  },
  {
   "at": 0.2,
   "do": "command",
   "run": "scoreboard players display name online vc {translate:\"score.unallocated.online\"}"
  },
  {
   "at": 0.2,
   "do": "command",
   "run": "scoreboard players set rank vc 3"
  },
  {
   "at": 0.2,
   "do": "command",
   "run": "scoreboard players display name rank vc {translate:\"score.unallocated.rank\"}"
  },
  {
   "at": 0.2,
   "do": "command",
   "run": "scoreboard players set address vc 1"
  },
  {
   "at": 0.2,
   "do": "command",
   "run": "scoreboard players display name address vc {translate:\"score.unallocated.address\"}"
  },
  {
   "at": 0.3,
   "do": "command",
   "run": "give @s minecraft:compass[minecraft:custom_name={translate:\"item.unallocated.selector\",italic:false},minecraft:lore=[{translate:\"item.unallocated.selector.lore\",italic:false}]]"
  },
  {
   "at": 0.3,
   "do": "command",
   "run": "give @s minecraft:written_book[minecraft:written_book_content={title:\"ValleCraft\",author:\"Staff\",pages:[{raw:{translate:\"item.unallocated.rules.0\"}},{raw:{translate:\"item.unallocated.rules.1\"}}]},minecraft:custom_name={translate:\"item.unallocated.rules\",italic:false}]"
  },
  {
   "at": 0.3,
   "do": "command",
   "run": "give @s minecraft:spyglass[minecraft:custom_name={translate:\"item.unallocated.spyglass\",italic:false},minecraft:lore=[{translate:\"item.unallocated.spyglass.lore\",italic:false}]]"
  },
  {
   "at": 0.5,
   "do": "title",
   "title": {
    "es": "ValleCraft Network",
    "en": "ValleCraft Network"
   },
   "subtitle": {
    "es": "Bienvenido de nuevo, {player}",
    "en": "Welcome back, {player}"
   },
   "fade_in": 0.5,
   "stay": 3,
   "fade_out": 1
  },
  {
   "at": 1.5,
   "do": "chat",
   "text": {
    "es": "[ValleCraft] Bienvenido a ValleCraft Network · Survival · Minijuegos · Plots",
    "en": "[ValleCraft] Welcome to ValleCraft Network · Survival · Minigames · Plots",
    "color": "#55ffff"
   }
  },
  {
   "at": 2.5,
   "do": "chat",
   "text": {
    "es": "[ValleCraft] Usa la brújula para elegir un modo. Lee las reglas antes de jugar.",
    "en": "[ValleCraft] Use the compass to choose a mode. Read the rules before you play.",
    "color": "#55ffff"
   }
  },
  {
   "at": 4,
   "do": "actionbar",
   "text": {
    "es": "Explora el hub. La salida a SURVIVAL está al este del spawn →",
    "en": "Explore the hub. The way to SURVIVAL is east of spawn →"
   }
  }
 ],
 "on_resume": [
  {
   "at": 0.5,
   "do": "audio",
   "cue": "ambient"
  },
  {
   "at": 0,
   "do": "command",
   "run": "unallocated tab frame"
  }
 ],
 "escape": [
  {
   "at": 0,
   "do": "chat",
   "text": {
    "es": "el suelo de la mina cede.",
    "en": "the mine floor gives way.",
    "color": "#8a8a8a"
   }
  },
  {
   "at": 0,
   "do": "blackout",
   "fade_in": 0.3,
   "hold": 1.2,
   "fade_out": 0.6
  }
 ],
 "beats": [
  {
   "id": "server.returning",
   "when": {
    "type": "chapter_start"
   },
   "if": {
    "flags": [
     "returning"
    ]
   },
   "actions": [
    {
     "at": 9,
     "do": "command",
     "run": "unallocated tab echo"
    },
    {
     "at": 10,
     "do": "chat",
     "text": {
      "es": "[ValleCraft] {player} ya está conectado.",
      "en": "[ValleCraft] {player} is already connected.",
      "color": "#55ffff"
     }
    },
    {
     "at": 14,
     "do": "actionbar",
     "text": {
      "es": "Tu nombre aparece dos veces en la lista. Tab.",
      "en": "Your name is on the list twice. Tab."
     }
    }
   ]
  },
  {
   "id": "server.explorer",
   "when": {
    "type": "chapter_start"
   },
   "if": {
    "flags": [
     "arrival.explorer"
    ]
   },
   "actions": [
    {
     "at": 6,
     "do": "chat",
     "text": {
      "es": "[ValleCraft] Última actividad registrada: 14/06/2021.",
      "en": "[ValleCraft] Last recorded activity: 06/14/2021.",
      "color": "#55ffff"
     }
    },
    {
     "at": 8,
     "do": "chat",
     "text": {
      "es": "[ValleCraft] Jugadores conectados: 1 (tú).",
      "en": "[ValleCraft] Players online: 1 (you).",
      "color": "#55ffff"
     }
    }
   ]
  },
  {
   "id": "server.former",
   "when": {
    "type": "chapter_start"
   },
   "if": {
    "flags": [
     "arrival.former"
    ]
   },
   "actions": [
    {
     "at": 6,
     "do": "chat",
     "text": {
      "es": "[ValleCraft] Rango restaurado: Ayudante.",
      "en": "[ValleCraft] Rank restored: Helper.",
      "color": "#55ffff"
     }
    },
    {
     "at": 6,
     "do": "command",
     "run": "scoreboard players display name rank vc {translate:\"score.unallocated.rank_helper\"}"
    },
    {
     "at": 0,
     "do": "command",
     "run": "unallocated arrival sign -30 66 11"
    },
    {
     "at": 8,
     "do": "chat",
     "text": {
      "es": "[ValleCraft] Tu casa sigue protegida a tu nombre. Nadie la ha tocado.",
      "en": "[ValleCraft] Your house is still claimed in your name. Nobody touched it.",
      "color": "#55ffff"
     }
    }
   ]
  },
  {
   "id": "server.invited",
   "when": {
    "type": "chapter_start"
   },
   "if": {
    "flags": [
     "arrival.invited"
    ]
   },
   "actions": [
    {
     "at": 0,
     "do": "command",
     "run": "unallocated tab add Kai"
    }
   ]
  },
  {
   "id": "server.selector",
   "when": {
    "type": "use_item",
    "item": "minecraft:compass"
   },
   "repeat": {
    "max": 6,
    "cooldown_seconds": 3
   },
   "actions": [
    {
     "at": 0,
     "do": "chat",
     "text": {
      "es": "SURVIVAL — en línea",
      "en": "SURVIVAL — online",
      "color": "#55ff55"
     }
    },
    {
     "at": 0,
     "do": "chat",
     "text": {
      "es": "MINIJUEGOS — fuera de línea",
      "en": "MINIGAMES — offline",
      "color": "#8a8a8a"
     }
    },
    {
     "at": 0,
     "do": "chat",
     "text": {
      "es": "PLOTS — fuera de línea",
      "en": "PLOTS — offline",
      "color": "#8a8a8a"
     }
    },
    {
     "at": 0,
     "do": "chat",
     "text": {
      "es": "CREATIVO — fuera de línea",
      "en": "CREATIVE — offline",
      "color": "#8a8a8a"
     }
    },
    {
     "at": 0.6,
     "do": "chat",
     "text": {
      "es": "▓▓▓ — UNALLOCATED",
      "en": "▓▓▓ — UNALLOCATED",
      "color": "#aa0000"
     }
    }
   ]
  },
  {
   "id": "server.leave_hub",
   "when": {
    "type": "zone",
    "zone": "lobby.exit"
   },
   "actions": [
    {
     "at": 0,
     "do": "chat",
     "text": {
      "es": "[ValleCraft] Mundo Survival. Las zonas protegidas tienen dueño: respétalas.",
      "en": "[ValleCraft] Survival world. Claimed land has an owner: respect it.",
      "color": "#55ffff"
     }
    },
    {
     "at": 4,
     "do": "command",
     "run": "unallocated tab add Noor"
    },
    {
     "at": 4,
     "do": "chat",
     "text": {
      "es": "Noor se unió a la partida",
      "en": "Noor joined the game",
      "color": "#ffff55"
     }
    },
    {
     "at": 6,
     "do": "bait",
     "op": "place",
     "scare": true,
     "seed": 4114,
     "lure": "hill.bait",
     "fallback_after": 40
    },
    {
     "at": 8,
     "do": "actionbar",
     "text": {
      "es": "Hay alguien de pie en la colina, al norte.",
      "en": "Someone is standing on the hill to the north."
     }
    }
   ],
   "capture": {
    "name": "hub",
    "at": 0.5
   }
  },
  {
   "id": "server.bait_scream",
   "when": {
    "type": "bait",
    "event": "screamer"
   },
   "actions": [
    {
     "at": 1.5,
     "do": "chat",
     "text": {
      "es": "Can't keep up! Is the server overloaded? Running 2047ms or 40 ticks behind",
      "en": "Can't keep up! Is the server overloaded? Running 2047ms or 40 ticks behind",
      "color": "#8a8a8a"
     }
    },
    {
     "at": 1.5,
     "do": "audio",
     "cue": "muffle"
    },
    {
     "at": 3,
     "do": "command",
     "run": "unallocated tab remove Noor"
    },
    {
     "at": 3,
     "do": "chat",
     "text": {
      "es": "Noor salió de la partida",
      "en": "Noor left the game",
      "color": "#ffff55"
     }
    },
    {
     "at": 5,
     "do": "actionbar",
     "text": {
      "es": "La base compartida queda al final del camino, hacia el este, pasando la casa de piedra de Zuri.",
      "en": "The shared base is at the east end of the road, past Zuri's stone house."
     }
    }
   ],
   "capture": {
    "name": "colina",
    "at": 0.5
   },
   "autoplay": {
    "wait_seconds": 30
   }
  },
  {
   "id": "server.bait_force",
   "when": {
    "type": "after",
    "seconds": 75,
    "beat": "server.leave_hub"
   },
   "if": {
    "not_beats": [
     "server.bait_scream"
    ]
   },
   "actions": [
    {
     "at": 0,
     "do": "bait",
     "op": "scare"
    }
   ]
  },
  {
   "id": "server.lost_time",
   "when": {
    "type": "zone",
    "zone": "presa.path"
   },
   "actions": [
    {
     "at": 0,
     "do": "blackout",
     "fade_in": 0.05,
     "hold": 0.4,
     "fade_out": 0.3
    },
    {
     "at": 0,
     "do": "audio",
     "cue": "muffle"
    },
    {
     "at": 0.1,
     "do": "command",
     "run": "time add 2500"
    },
    {
     "at": 1.2,
     "do": "chat",
     "text": {
      "es": "[Server] Lag detectado: 2500 ticks omitidos. Reloj resincronizado.",
      "en": "[Server] Lag detected: 2500 ticks skipped. Clock resynchronized.",
      "color": "#8a8a8a"
     }
    },
    {
     "at": 2.5,
     "do": "actionbar",
     "text": {
      "es": "¿Ya es de noche? Hace un momento era de día.",
      "en": "Night already? It was daytime a moment ago."
     }
    }
   ],
   "autoplay": {
    "wait_seconds": 90
   }
  },
  {
   "id": "server.sprint",
   "when": {
    "type": "sprint",
    "seconds": 4
   },
   "actions": [
    {
     "at": 0,
     "do": "chat",
     "text": {
      "es": "no corras. no sirve el dato si corres.",
      "en": "don't run. the data is useless if you run."
     },
     "from": {
      "es": "{player}",
      "en": "{player}"
     }
    }
   ]
  },
  {
   "id": "server.rewrite",
   "when": {
    "type": "chat",
    "pattern": "\\S",
    "hide": true
   },
   "actions": [
    {
     "at": 0,
     "do": "chat",
     "text": {
      "es": "vamos al pozo",
      "en": "let's go to the pit"
     },
     "from": {
      "es": "{player}",
      "en": "{player}"
     }
    }
   ],
   "autoplay": {
    "input": "vamos a la izquierda"
   }
  },
  {
   "id": "server.fury",
   "when": {
    "type": "chat",
    "pattern": "(?i)reclaimer"
   },
   "actions": [
    {
     "at": 0,
     "do": "chat",
     "text": {
      "es": "muestra inválida :: el sujeto conoce la designación",
      "en": "invalid sample :: the subject knows the designation",
      "color": "#aa0000"
     }
    },
    {
     "at": 0.3,
     "do": "audio",
     "cue": "muffle"
    },
    {
     "at": 0.3,
     "do": "interface",
     "effect": "GAMMA",
     "seconds": 4,
     "strength": 1
    }
   ],
   "autoplay": {
    "input": "reclaimer"
   }
  },
  {
   "id": "server.base",
   "when": {
    "type": "zone",
    "zone": "base.theft_zone"
   },
   "actions": [
    {
     "at": 0.5,
     "do": "actionbar",
     "text": {
      "es": "Los griefers pasaron por aquí cuando ya no quedaba nadie. Solo hay un cofre, y parece más nuevo que lo demás.",
      "en": "Griefers got here after everyone left. There is only one chest, and it looks newer than everything else."
     }
    },
    {
     "at": 8,
     "do": "interface",
     "effect": "SIGN",
     "seconds": 5,
     "generation": 2,
     "strength": 0.5,
     "leak": "mixed",
     "seed": 4114,
     "sign": {
      "pos": [
       53,
       64,
       10
      ]
     },
     "text": {
      "es": "objetivo: obtener fear de subject // retry",
      "en": "objective: obtain fear from subject // retry"
     }
    },
    {
     "at": 14,
     "do": "actionbar",
     "text": {
      "es": "Detrás de la base está la mina.",
      "en": "Behind the base is the mine."
     }
    }
   ],
   "capture": {
    "name": "base",
    "at": 1
   },
   "autoplay": {
    "wait_seconds": 100
   }
  },
  {
   "id": "server.mine",
   "when": {
    "type": "zone",
    "zone": "mine.entrance"
   },
   "actions": [
    {
     "at": 0,
     "do": "actionbar",
     "text": {
      "es": "La mina de Noor. Al fondo, el piso suena hueco.",
      "en": "Noor's mine. At the far end, the floor sounds hollow."
     }
    }
   ],
   "autoplay": {
    "wait_seconds": 110
   }
  },
  {
   "id": "server.fall",
   "when": {
    "type": "zone",
    "zone": "presa.mine_end"
   },
   "actions": [
    {
     "at": 0,
     "do": "command",
     "run": "fill ~-1 ~-1 ~-1 ~1 ~-5 ~1 minecraft:air"
    },
    {
     "at": 0,
     "do": "audio",
     "cue": "muffle"
    },
    {
     "at": 0.1,
     "do": "chat",
     "text": {
      "es": "el suelo de la mina cede.",
      "en": "the mine floor gives way.",
      "color": "#8a8a8a"
     }
    },
    {
     "at": 0.45,
     "do": "blackout",
     "fade_in": 0.15,
     "hold": 0.9,
     "fade_out": 0.8
    },
    {
     "at": 0.7,
     "do": "next_chapter"
    }
   ]
  },
  {
   "id": "server.nudge_hub",
   "when": {
    "type": "after",
    "seconds": 90
   },
   "if": {
    "not_beats": [
     "server.leave_hub"
    ]
   },
   "actions": [
    {
     "at": 0,
     "do": "actionbar",
     "text": {
      "es": "La puerta de SURVIVAL está al este del spawn. Sigue el camino →",
      "en": "The SURVIVAL gate is east of spawn. Follow the road →"
     }
    }
   ]
  },
  {
   "id": "server.nudge_base",
   "when": {
    "type": "after",
    "seconds": 200
   },
   "if": {
    "not_beats": [
     "server.base"
    ]
   },
   "actions": [
    {
     "at": 0,
     "do": "actionbar",
     "text": {
      "es": "Sigue el camino hacia el este, pasando la casa de piedra. La casa de madera con chimenea es la base.",
      "en": "Keep east along the road, past the stone house. The wooden house with the chimney is the base."
     }
    }
   ]
  },
  {
   "id": "server.nudge_mine",
   "when": {
    "type": "after",
    "seconds": 300
   },
   "if": {
    "not_beats": [
     "server.fall"
    ]
   },
   "actions": [
    {
     "at": 0,
     "do": "actionbar",
     "text": {
      "es": "La mina está detrás de la base. Entra y sigue hasta el fondo.",
      "en": "The mine is behind the base. Go in, all the way down."
     }
    }
   ]
  }
 ]
}